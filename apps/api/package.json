{
  "name": "@clinica/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@clinica/shared": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.5",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
